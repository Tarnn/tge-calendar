# Everything here is optional. The calendar, live odds and prices all work with no configuration.

# Issue reports by email (https://www.emailjs.com). Without these three values the
# "Report an issue" form opens a pre-filled GitHub issue instead. See EMAILJS_SETUP.md.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_BUG=
VITE_EMAILJS_PUBLIC_KEY=

# Build-time only. Absolute address used for link previews (og:image, canonical URL).
# Not needed on Vercel, where the project's production domain is used automatically.
# SITE_URL=https://example.com
